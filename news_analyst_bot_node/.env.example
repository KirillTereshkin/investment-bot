# ============================================================================
# Скопируйте этот файл в .env и заполните значения. Файл .env в git не попадает.
# ============================================================================

# --- Telegram --------------------------------------------------------------
# Токен бота, получить у @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# Ваш личный chat_id (узнать: @userinfobot или @getmyid_bot)
TELEGRAM_CHAT_ID=123456789

# --- DeepSeek --------------------------------------------------------------
# Ключ из личного кабинета https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-example-replace-me

# --- Tinkoff Invest (только чтение, необязательно) ---------------------------
# Токен с правами ТОЛЬКО на чтение: https://www.tinkoff.ru/invest/settings/api/
# Read-only токен не может выставлять или отменять ордера — бот торговать не умеет.
# Если переменная пуста, бот работает без блока «По вашим позициям» и без /portfolio.
TINKOFF_INVEST_TOKEN=

# Необязательно: конкретный счёт для портфеля. Если пусто — берётся первый брокерский.
# TINKOFF_ACCOUNT_ID=

# Транспорт API: rest (по умолчанию — обычный fetch, без дополнительных библиотек)
# или sdk (нужен установленный пакет @tinkoff/invest-nodejs-grpc-sdk).
# TINKOFF_TRANSPORT=rest

# Хосты REST T-Invest API: основной и резервные (через запятую). Перебираются при сбое сети.
# TINKOFF_API_HOST=https://invest-public-api.tbank.ru
# TINKOFF_API_BACKUP_HOSTS=https://invest-public-api.tinkoff.ru

# ============================================================================
# Значения ниже необязательны. Если их не задавать, используются значения
# по умолчанию из src/config.js (расписание 10,12,14,16,18,20 МСК, окно 120 минут,
# таймаут источника 10 сек, retry 2 раза и т.д.).
# ============================================================================
# ANALYSIS_HOURS=10,12,14,16,18,20
# TIMEZONE=Europe/Moscow
# NEWS_WINDOW_MINUTES=120
# MAX_DIGEST_LINES=25
# PREDICTION_CHECK_HOUR=21
# PREDICTION_CHECK_MINUTE=0
# PREDICTION_DEFAULT_HORIZON_DAYS=30
# PREDICTION_FLAT_THRESHOLD_PCT=1.0
# CBR_KEY_RATE_CACHE_HOURS=24
# TINKOFF_POSITIONS_CACHE_TTL_SEC=300

# --- Только для Node-версии ------------------------------------------------
# Уровень логов: debug | info | warning | error (по умолчанию info)
# LOG_LEVEL=info
# Пути к базе и логу. Нужны smoke_test.js, чтобы тесты не писали в рабочую базу.
# DB_PATH=C:\Projects\investment-bot\news_analyst_bot_node\news_bot.sqlite3
# LOG_PATH=C:\Projects\investment-bot\news_analyst_bot_node\bot.log
