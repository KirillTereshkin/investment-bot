# ============================================================================
# Скопируйте этот файл в .env и заполните значения. Файл .env в git не попадает.
# ============================================================================

# --- Telegram --------------------------------------------------------------
# Токен бота, получить у @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# Ваш личный chat_id (узнать: @userinfobot или @getmyid_bot)
TELEGRAM_CHAT_ID=123456789

# --- DeepSeek --------------------------------------------------------------
# Ключ из личного кабинета https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-example-replace-me

# ============================================================================
# Значения ниже необязательны. Если их не задавать, используются значения
# по умолчанию из config.py (расписание 10,12,14,16,18,20 МСК, окно 120 минут,
# таймаут источника 10 сек, retry 2 раза и т.д.).
# ============================================================================
# ANALYSIS_HOURS=10,12,14,16,18,20
# TIMEZONE=Europe/Moscow
# NEWS_WINDOW_MINUTES=120
# MAX_DIGEST_LINES=25
